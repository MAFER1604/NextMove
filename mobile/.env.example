# Copia a .env y ajusta según cómo corras el backend.
#
# Emulador Android (localhost de tu compu no es accesible desde el emulador):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
#
# Simulador iOS / Expo Web:
# EXPO_PUBLIC_API_URL=http://localhost:8000
#
# Teléfono físico (usa la IP LAN de tu computadora, ej. ipconfig/ifconfig):
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8000

EXPO_PUBLIC_API_URL=http://10.22.187.18:8000
EXPO_PUBLIC_USE_MOCK=false

# false (recomendado ahora que /app/* existe de verdad en el backend) = usa
# el backend real para todo: sesión, recomendaciones, aceptar/rechazar,
# pickup/delivery, rutas. Si el backend no responde, se muestra un error y
# un botón de reintentar — nunca cae en silencio a datos simulados.
#
# true = motor 100% en el teléfono (services/mockApi.ts), útil para probar
# la interfaz sin backend corriendo.
