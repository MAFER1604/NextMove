# Copia este archivo a .env y llena lo que necesites.
# Ninguna de estas claves es requerida para correr el demo: NextMove funciona
# completamente sin ellas (MockRouteProvider + estrategia por defecto).

# Solo usado FUERA del camino rápido de /decide (StrategyProvider):
# análisis post-turno, recomendaciones para la siguiente sesión, resúmenes.
ANTHROPIC_API_KEY=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

# Alternativa local a Claude para StrategyProvider. Opcional.
OLLAMA_BASE_URL=http://localhost:11434

# Solo para enriquecer/preparar escenarios (no se usa dentro de /decide).
# Para el subsistema /app/* (experiencia real de producto), SÍ es el
# proveedor de rutas principal — ver route_provider.py. Sin esta clave, el
# subsistema /app cae automáticamente al respaldo PrecomputedRouteProvider
# (rutas aproximadas, nunca líneas rectas, marcadas como "precomputed" en la
# respuesta) — nunca falla silenciosamente ni finge una ruta real.
TOMTOM_API_KEY=efFNN1O0GM49vyai5766IZSNOE95dbno

# CORS: orígenes permitidos para Expo, separados por coma. "*" para el demo.
CORS_ALLOW_ORIGINS=*
