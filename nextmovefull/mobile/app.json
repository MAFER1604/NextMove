{
  "expo": {
    "name": "NextMove",
    "slug": "nextmove",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "NextMove uses your location to find delivery opportunities along your route."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NextMove uses your location to find delivery opportunities along your route."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A"
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "REPLACE_WITH_YOUR_GOOGLE_MAPS_API_KEY_FOR_PRODUCTION_ONLY"
        }
      ]
    ]
  }
}
